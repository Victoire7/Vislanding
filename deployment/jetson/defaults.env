# Defaults shared by all bench helpers (matches safe_pre_demo.py).
#
# Override on the command line:
#   CKPT=/some/other.pth ./prepare_bench.sh ./models
#   CFG=mono/configs/HourglassDecoder/vit.raft5.small_uav_safe.py ...
#
# Source this file from a bash script with `source defaults.env` so each var
# only gets set if the caller didn't already export it.

# --- model / cfg / ckpt (defaults from safe_pre_demo.py) ---
: "${CFG:=mono/configs/HourglassDecoder/vit.raft5.small_uav_safe.py}"
: "${CKPT:=/home/vector/Tan/xunfeidan/Metric3D/final_model/student_step00004400_86.04.pth}"

# --- network input size (canonical Metric3D ViT-small input) ---
: "${HEIGHT:=616}"
: "${WIDTH:=1064}"

# --- benchmark grid ---
: "${ITERS_LIST:=1 4}"          # values of T (RAFT iterations) to bench
: "${PRECISIONS_LIST:=fp32 fp16}" # TensorRT build precision

# --- trtexec timing knobs ---
: "${WARMUP_MS:=2000}"
: "${RUN_ITERATIONS:=200}"

export CFG CKPT HEIGHT WIDTH ITERS_LIST PRECISIONS_LIST WARMUP_MS RUN_ITERATIONS
